---
import '@fontsource/damion'

import ClubCulturePartyFlyer from '@assets/club-culture-2025-06-07.webp'
import LoveHangoverJuly from '@assets/2025-07-10-love-hangover.webp'
import MachineClubFlyer from '@assets/2025-10-01-machine-club-filoso.jpg'
import NextPartyFlyer from '@assets/2025-10-01 love hangover.png'
import playlistFlyerSummer from '@assets/love-hangover-summer-2025.png'
import playlistFlyerSpring from '@assets/love-hangover-spring-2025.webp'
import FixedSection from '@components/FixedSection.astro'
import SpotifyPlaylist from '@components/SpotifyPlaylist.astro'
import Layout from '@layouts/Layout.astro'
import { Image } from 'astro:assets'
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro'
---

<Layout>
  <header>
    <h1>Love Hangover</h1>
    <p class="tagline">QUEER. PUNK. ACID. SWEAT.</p>
  </header>

  <main>
    <FixedSection
      id="next-party"
      headerText="Upcoming Events"
      suffix={true}
      class="next-party"
    >
      <Image
        src={NextPartyFlyer}
        alt="Love Hangover October 1st 2025 at Whistle Stop"
        class="next-party-flyer"
      />
    </FixedSection>
    <FixedSection id="next-party-info" headerText="" class="next-party-info">
      <p>
        Love Hangover presents...
        <h3>Extraterrestre</h3>
        <h3>FKA Victor</h3>
        <h3>Skreemn Meme</h3>
        <h3>Silica Sun</h3>
        Wednesday, October 1st 2025 at Whistle Stop <br />
        <a href="https://ra.co/events/2205958" target="_blank"
          >Event Info + RSVP</a
        >
      </p>
    </FixedSection>
    <FixedSection
      id="latest-party"
      headerText=""
      suffix={true}
      class="next-party"
    >
      <Image
        src={MachineClubFlyer}
        alt="Machine Club October 2nd 2025 at Club Tee Gee"
        class="next-party-flyer"
      />
    </FixedSection>
    <FixedSection id="past-party-info" headerText="" class="next-party-info">
      <p>
        Restless Nights Presents...
        <h3>Machine Club</h3>
        Saturday, June 7th 2025 at The Casbah <br />
        <a
          href="https://wl.seetickets.us/event/club-culture/650219?afflky=Casbah"
          target="_blank">Event Info</a
        >
      </p>
    </FixedSection>
    <!-- past events -->
    <FixedSection
      id="Love Hangover July"
      headerText="Past Events"
      suffix={true}
      class="next-party"
    >
      <Image
        src={LoveHangoverJuly}
        alt="Love Hangover July 10th 2025 at Whistle Stop"
        class="next-party-flyer"
      />
    </FixedSection>
    <FixedSection id="next-party-info" headerText="" class="next-party-info">
      <p>
        Love Hangover presents...
        <h3>Club Majo</h3>
        <h3>Mind Research</h3>
        <h3>GOEUR</h3>
        Thursday, July 10th 2025 at Whistle Stop <br />
        <a href="https://ra.co/events/2205958" target="_blank"
          >Event Info + RSVP</a
        >
      </p>
    </FixedSection>
    <FixedSection
      id="latest-party"
      headerText=""
      suffix={true}
      class="next-party"
    >
      <Image
        src={ClubCulturePartyFlyer}
        alt="Club Culture June 7th 2025 at The Casbah"
        class="next-party-flyer"
      />
    </FixedSection>
    <FixedSection id="past-party-info" headerText="" class="next-party-info">
      <p>
        Dream and Messy Era Present...
        <h3>Club Culture</h3>
        Saturday, June 7th 2025 at The Casbah <br />
        <a
          href="https://wl.seetickets.us/event/club-culture/650219?afflky=Casbah"
          target="_blank">Event Info + Presale Tickets</a
        >
      </p>
    </FixedSection>

    <FixedSection
      id="lh-playlist-header"
      headerText="Check out our playlists"
      suffix={true}
      class="playlist-header"
    >
      <div class="playlist-info">
        <p>
          120 minutes featuring a slice of Love Hangover’s most intoxicating &
          dangerous cuts.
        </p>
        <em class="playlist-tagline">
          &ldquo;Some secrets are meant to be heard.&rdquo;
        </em>
        <p>
          Curated by <a
            href="https://www.instagram.com/lola_rey_/"
            target="_blank">Miss Lady D</a
          > & <a href="https://www.instagram.com/antithetic" target="_blank"
            >Filoso</a
          >.
        </p>
      </div>
      <Image
        src={playlistFlyerSummer}
        alt="LOVE HANGOVER Spring 2025 Spotify Playlist"
        class="playlist-graphic"
      />
    </FixedSection>

    <FixedSection id="lh-playlist" headerText="" class="playlist">
      <div class="playlist-title">
        <h3>Summer 2025</h3>
      </div>
      <div class="playlist-info">
        <p>
          This summer we turned it up a notch and go deep with our selections.
          These ones will make you go bang.
        </p>

        <p>
          Listen on Spotify [<a
            href="https://go.consent.press/love-hangover-summer-2025"
            target="_blank">LINK</a
          >]
        </p>
      </div>

      <div class="playlist-embed">
        <SpotifyPlaylist
          playlistUrl="https://open.spotify.com/playlist/5sAdC54u8cSqgUy6oBLgeI?si=00731ea2c2be4b2d"
          compact={true}
        />
      </div>
    </FixedSection>

    <FixedSection
      id="lh-playlist-header"
      headerText=""
      suffix={true}
      class="playlist-header"
    >
      <Image
        src={playlistFlyerSpring}
        alt="LOVE HANGOVER Spring 2025 Spotify Playlist"
        class="playlist-graphic"
      />
    </FixedSection>
    <FixedSection id="lh-playlist" headerText="" class="playlist">
      <div class="playlist-title">
        <h3>Spring 2025</h3>
      </div>
      <div class="playlist-info">
        <p>
          Tune in to our Spring 2025 playlist, featuring A selection of spring
          time warmers and breezy club bangers.
        </p>

        <p>
          Listen on Spotify [<a
            href="https://go.consent.press/love-hangover-spring-2025"
            target="_blank">LINK</a
          >]
        </p>
      </div>

      <div class="playlist-embed">
        <SpotifyPlaylist
          playlistUrl="https://open.spotify.com/playlist/47b3JV89sKcL6dkC3bMO6p?si=tcToFt5LSvW_4FedcHpT6w"
          compact={true}
        />
      </div>
    </FixedSection>
  </main>

  <footer>
    <div>A party by Consent &copy; 2025</div>
    <div class="links">
      follow us ~ <a
        href="https://instagram.com/love.hangover.sd"
        target="_blank"><InstagramLogo class="icon" /></a
      >
    </div>
  </footer>
</Layout>
